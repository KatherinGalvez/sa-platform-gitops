# Copie este archivo a p9.env y ajuste los valores. p9.env NO se sube a Git.
# Ningun valor aqui es secreto: son identificadores del proyecto.

# ID del proyecto de Google Cloud (no el nombre). Lo ve en la consola arriba a la izquierda.
PROYECTO="mi-proyecto-p9"

# Region y zona del cluster (zonal = mas barato; la zona debe estar dentro de la region)
REGION="us-central1"
ZONA="us-central1-a"

# Nombre del cluster GKE
CLUSTER="p9-dr"

# Tipo y numero de nodos (3 nodos minimo para anti-afinidad y prueba de drenaje)
TIPO_MAQUINA="e2-standard-2"
NODOS=3

# Repositorio GitOps PUBLICO que leera ArgoCD y ruta a la carpeta gitops de P9
REPO_URL="https://github.com/KatherinGalvez/sa-platform-gitops.git"
REPO_RAMA="main"
GITOPS_RUTA="P9/gitops"

# Buckets (se derivan del proyecto; normalmente no hace falta cambiarlos)
BUCKET_ESTADO="${PROYECTO}-p9-tfstate"
BUCKET_VELERO="${PROYECTO}-p9-velero"

# Zona horaria para las marcas de tiempo de las evidencias
TZ="America/Guatemala"
