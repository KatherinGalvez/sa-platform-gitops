# Copie este archivo a p10.env (cp p10.env.ejemplo p10.env). No contiene secretos.
PROYECTO="sa-p6-202006633"
REGION="us-central1"
ZONA="us-central1-a"

# Cluster PROPIO de la Practica 10 (el auxiliar pidio entornos separados: p9-dr y p10-obs)
CLUSTER="p10-obs"
TIPO_MAQUINA="e2-standard-2"
NODOS=2

# Imagen de los servicios (Artifact Registry). Si cambia la version, cambiela
# tambien en gitops/produccion/*.yaml
REPOSITORIO_IMAGENES="p10"
IMAGEN="us-central1-docker.pkg.dev/sa-p6-202006633/p10/tienda"
VERSION_IMAGEN="1.0.0"

TZ="America/Guatemala"
